{
  "status": "redacted",
  "rules": [
    "animation-counter",
    "api-token",
    "bearer-token",
    "elapsed-duration",
    "email",
    "home-path",
    "local-time",
    "pid",
    "rfc3339",
    "socket-file",
    "transient-file",
    "uuid",
    "worktree-path"
  ],
  "hit_counts": {
